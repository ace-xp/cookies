{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/docs/delivery/schemas/compiled-delivery-workflow-v1.json",
  "title": "CompiledDeliveryWorkflow v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "organization_id", "project_id", "decision_id", "decision_canonical_hash", "selected_candidate_id", "configuration_canonical_hash", "configuration_id", "configuration_version", "platform", "profile_version", "account_reference", "capability_contract_version", "selector_contract_version", "action_contract_version", "compiler_version", "status", "remote_write_enabled", "steps", "canonical_hash", "created_by", "created_at"],
  "properties": {
    "schema_version": { "const": "compiled-delivery-workflow/v1" },
    "id": { "type": "string" },
    "organization_id": { "type": "string" },
    "project_id": { "type": "string" },
    "decision_id": { "type": "string" },
    "decision_canonical_hash": { "$ref": "#/$defs/hash" },
    "selected_candidate_id": { "type": "string" },
    "configuration_canonical_hash": { "$ref": "#/$defs/hash" },
    "configuration_id": { "type": "string" },
    "configuration_version": { "type": "integer", "minimum": 1 },
    "platform": { "const": "ocean_engine" },
    "profile_version": { "const": "oceanengine-configuration/v1" },
    "account_reference": { "$ref": "delivery-platform-configuration-v2.json#/$defs/StableReference" },
    "capability_contract_version": { "const": "oceanengine-capability/v0.1" },
    "selector_contract_version": { "const": "oceanengine-selector-contract/v0.1" },
    "action_contract_version": { "const": "oceanengine-action-contract/v0.1" },
    "compiler_version": { "const": "oceanengine-workflow-compiler/v1" },
    "status": { "const": "ready_for_final_approval" },
    "remote_write_enabled": { "const": false },
    "steps": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sequence", "page", "action", "risk", "preconditions", "fields", "timeout_seconds", "recovery", "blocked"],
        "properties": {
          "id": { "type": "string" },
          "sequence": { "type": "integer", "minimum": 1 },
          "page": { "type": "string" },
          "action": { "type": "string" },
          "risk": { "enum": ["observe", "prepare_local_form", "remote_write"] },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "value", "expected_readback", "evidence_ref"],
              "properties": {
                "key": { "type": "string" },
                "value": true,
                "expected_readback": true,
                "evidence_ref": { "type": "string" }
              }
            }
          },
          "timeout_seconds": { "type": "integer", "minimum": 0 },
          "recovery": { "type": "string" },
          "blocked": { "type": "boolean" },
          "block_reason": { "const": "PHASE_C_REMOTE_WRITE_PROHIBITED" }
        },
        "allOf": [{ "if": { "properties": { "risk": { "const": "remote_write" } } }, "then": { "required": ["block_reason"], "properties": { "blocked": { "const": true }, "block_reason": { "const": "PHASE_C_REMOTE_WRITE_PROHIBITED" } } } }]
      }
    },
    "canonical_hash": { "$ref": "#/$defs/hash" },
    "created_by": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
