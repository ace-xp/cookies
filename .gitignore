# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Local environment files may contain credentials. Keep only the empty template.
.env
.codex-runtime/

# Node / Vite frontend artifacts
node_modules/
web/dist/
web/.vite/
test-results/
/output/
*.tsbuildinfo

# Local persistent object storage
.data/
.tmp/
tmp/
/.cache/

# Local MVP backend persistence. Keep deployable public insight examples.
/data/*
!/data/insights/
!/data/insights/**

# Editor/IDE
# .idea/
# .vscode/

# macOS Finder metadata
.DS_Store

# Frontend dependencies and build artifacts
node_modules/
dist/
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# 本地播种脚本的临时产物（scripts/seed-*.sql 才是提交的那份）
.tmp-seed/

# Claude Code 本地配置
.claude/
